שתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתצוÚן°†כRכQכQכQכQכQכQלPלPלPלPל‹PלPם‰Oם‰OםˆOםˆOםˆOםˆOם‡Oם‡Oם†Nם†Nמ…Nמ…Nמ…Nמ…Nמ„Nמ„NמƒMמƒMן‚Mן‚MןMןMן€Lן€Lן€Lן€Lנ€Lנ€LנLנLנ~Lנ~Lנ}Kנ}Kנ|Kנ|Kנ{Kנ{Kנ{Kנ{KנzJנzJסyJסyJסxJסxJסwJסwJסvIסvIעuIעuIעuIעuIעtIעtIעsHעsHעsHעsHףrHףrHףqHףqHףqHףqHףpHףpHףpHףpHפoHפoHפoHפoHפnHפnHפnGפnGפmGפmGפlGפlGץlGץlGץlGץlGץkGץkGץjFץjFץiFץiFצiFצiFצhFצhFצhFצhFצgEצgEצgEצgEצfEצfEקeEקeEקeEקeEקdDקdDקdDקdDקcDקcDקcDקcDקcDקcDקcDקcDרcDרcDרbDרbDרbCרbCרaCרaCר`Cר`Cר`Cר`Cר`Cר`Cש_Cש_Cש_Cש_Cש_Cש_Cש^Bש^Bש^Bש^Bש^Bש^Bש]Bש]Bש]B