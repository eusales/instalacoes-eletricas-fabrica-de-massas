שתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתץוÚמ²‡ך’Sך‘RךRכQכQכQכQכQכQכPכPלPלPלPלPל‹Pל‹PםOםOם‰Oם‰OםˆOםˆOם‡Nם‡Nמ†Nמ†Nמ…Nמ…Nמ„Nמ„NמƒMמƒMןƒMןƒMן‚Mן‚MןMןMן€Lן€LנLנLנLנLנ~Lנ~Lנ}Kנ}Kנ}Kנ}Kנ|Kנ|Kנ{Kנ{KנzJנzJסyJסyJסxJסxJסxJסxJסwIסwIסvIסvIעuIעuIעuIעuIעtIעtIעsHעsHעrHעrHףrHףrHףqHףqHףqHףqHףqHףqHףqHףqHפpHפpHפoHפoHפnGפnGפmGפmGפmGפmGפmGפmGץlGץlGץkGץkGץjFץjFץjFץjFץiFץiFץiFץiFצhFצhFצhFצhFצgEצgEצgEצgEצfEצfEצfEצfEצeEצeEקeEקeEקeEקeEקdDקdDקdDקdDקcDקcDקcDקcDקcDקcDקcDקcDרcDרcDרbDרbDרbDרbDרbDרbDרbCרbCרaCרaCרaCרaCר`Cר`Cר`Cר`Cר_Cר_Cש_Cש_Cש_Cש_Cש_Cש_Cש_Cש_Cש^Bש^Bש^Bש^Bש]Bש]Bש]Bש]Bש\Bש\Bש\Bש\Bש\Bש\Bת\Bת\Bת\Bת\Bת\Bת\Bת\Bת\Bת[Bת[Bת[Bת[Bת[Aת[Aת[Aת[Aת[Aת[Aת[A