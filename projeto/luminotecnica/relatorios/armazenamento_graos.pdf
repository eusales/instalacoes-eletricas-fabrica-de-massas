שתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתÿÿÿÿÿÿרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתפכÝךָה²`ה²_ה±_ה±_ה±^ה±^ה°^ה°^ה¯^ה¯^ה¯^ה¯^ו®]ו®]ו­]ו­]ו­]ו­]ו¬]ו¬]ו¬\ו¬\ו«\ו«\ו×\ו×\ו×\ו×\ו×[ו×[ו×[ו×[ו©[ו©[ז©[ז©[ז¨Zז¨Zז¨Zז¨Zז§Zז§Zז¦Zז¦Zז¦Yז¦Yז¥Yז¥Yז¥Yז¥Yז₪Yז₪Yז₪Yז₪Yז£Xז£Xז£Xז£Xז£Xז£Xח¢Xח¢Xח¡Wח¡Wח¡Wח¡Wח Wח Wח Wח Wח