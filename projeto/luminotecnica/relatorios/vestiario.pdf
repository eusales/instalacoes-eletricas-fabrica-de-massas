תרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתÿÿÿÿÿÿרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתפןÝי׳—