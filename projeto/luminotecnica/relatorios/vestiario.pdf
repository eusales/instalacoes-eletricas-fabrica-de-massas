שתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתÿÿÿÿÿÿרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתפןÞי׳—דֹmדֹ