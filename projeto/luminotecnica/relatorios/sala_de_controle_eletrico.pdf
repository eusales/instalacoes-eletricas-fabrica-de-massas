תרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתÿÿÿÿÿÿרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרשתרםך